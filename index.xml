<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Zhen Chen's Homepage</title><link>https://zhenchen-jay.github.io/</link><atom:link href="https://zhenchen-jay.github.io/index.xml" rel="self" type="application/rss+xml"/><description>Zhen Chen's Homepage</description><generator>Wowchemy (https://wowchemy.com)</generator><language>en-us</language><lastBuildDate>Mon, 24 Oct 2022 00:00:00 +0000</lastBuildDate><image><url>https://zhenchen-jay.github.io/media/icon_hu_d753c9fcf2752dfe.png</url><title>Zhen Chen's Homepage</title><link>https://zhenchen-jay.github.io/</link></image><item><title>Private Demos</title><link>https://zhenchen-jay.github.io/demos/</link><pubDate>Tue, 21 Apr 2026 00:00:00 +0000</pubDate><guid>https://zhenchen-jay.github.io/demos/</guid><description>&lt;div id="lock-screen" style="text-align:center; padding: 80px 20px;">
&lt;h2>🔒 Private Demo Access&lt;/h2>
&lt;p>This page contains unpublished project demos. Please enter the password to continue.&lt;/p>
&lt;input id="pwd-input" type="password" placeholder="Enter password"
style="padding:10px 16px; font-size:1em; border-radius:6px; border:1px solid #ccc; margin-right:8px; width:220px;">
&lt;button onclick="checkPassword()"
style="padding:10px 20px; font-size:1em; border-radius:6px; background:#1565c0; color:#fff; border:none; cursor:pointer;">
Enter
&lt;/button>
&lt;p id="pwd-error" style="color:red; margin-top:12px; display:none;">Incorrect password. Try again.&lt;/p>
&lt;/div>
&lt;div id="demo-content" style="display:none;">
&lt;h3 id="physics-informed-generation">Physics-Informed Generation&lt;/h3>
&lt;div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; margin-bottom:24px;">
&lt;div>
&lt;video width="100%" height="300" autoplay loop muted playsinline style="object-fit:cover;">
&lt;source src="https://zhenchen-jay.github.io/uploads/videos/PhysicsInformedGeneration/physical_guide_cropped.mp4" type="video/mp4">
&lt;/video>
&lt;p style="text-align:center; font-size:0.85em;">Physical Guide&lt;/p>
